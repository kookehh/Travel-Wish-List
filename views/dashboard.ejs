    body {
        padding-top: 80px; /* keep your existing navbar offset */
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(to bottom right, #caf0f8, #fde2e4);
        min-height: 100vh;
        padding-top: 100px;
    }

    .card {
        max-width: 1100px;
        margin: 1rem auto;
        text-align: center;
    }

    .card-body {
        padding: 0.5rem 1rem;
    }

    table.table {
        font-size: 0.85rem;
    }

    table.table th, table.table td {
        padding: 0.3rem 0.5rem;
        vertical-align: middle;
    }

    table.table th {
        background-color: rgb(255, 226, 231);
    }



  </style>
