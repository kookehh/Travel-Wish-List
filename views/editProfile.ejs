<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Profile – Travel Wishlist App</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(to bottom right, #fde2ff, #e0f7ff);
      min-height: 100vh;
      padding-top: 80px;
    }

    .navbar {
      background-color: #1f1f23 !important;
      padding: 0.8rem 2rem;
    }

    .navbar-brand {
      font-weight: 600;
      font-size: 1.5rem;
      color: #ffffff !important;
    }

    .navbar-nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-right: 1rem;
    }

    .nav-link {
      font-weight: 400;
      font-size: 1rem;
      color: #ffffff !important;
    }

    .nav-link:hover {
      color: #d0d0d0 !important;
    }

    .form-container {
      background: #ffffff;
      border-radius: 20px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
      padding: 40px;
      max-width: 500px;
      margin: auto;
    }

    h2 {
      color: #6a5acd;
      font-weight: 600;
    }

    .btn-dark {
      background-color: #1f1f23;
      border: none;
      font-weight: 500;
    }

    .btn-dark:hover {
      background-color: #3a3a3f;
    }

    label {
      font-weight: 500;
      color: #555;
    }
  </style>
</head>

<body>

  <nav class="navbar navbar-expand-sm fixed-top">
    <div class="container-fluid d-flex justify-content-between align-items-center">
      <a class="navbar-brand" href="/country">Jet2Go</a>
    </div>
  </nav>

  <div class="container mt-5">
    <div class="form-container">
      <h2 class="text-center mb-4">Edit Profile</h2>

      <form action="/wishlist/editProfile/<%= users.id %>" method="POST" enctype="multipart/form-data">
        <div class="mb-4">
          <label for="image" class="form-label">Change Image</label>
          <input class="form-control" type="file" id="image" name="image" accept="image/*">
        </div>

        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" class="form-control" id="username" name="username" value="<%= users.username %>" required>
        </div>

        <div class="mb-3">
          <label for="bio" class="form-label">Bio</label>
          <textarea class="form-control" id="bio" name="bio" rows="3" required><%= profile.bio %></textarea>
        </div>

        <div class="d-grid">
          <button type="submit" class="btn btn-dark">Update Profile</button>
        </div>
      </form>
    </div>
  </div>

</body>
</html>
