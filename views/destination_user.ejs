<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Supermarket App</title>
</head>
<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Supermarket App 123</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/cart">View Cart</a>
            </li> 
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li> 
          </ul>
        </div>
      </div>
    </nav>

  <div class="container mt-4">
    <h2 class="text-center mb-4">Destinations in This List</h2>

    <% if (destinations.length > 0) { %>
      <div class="row">
        <% destinations.forEach(dest => { %>
          <div class="col-md-4 mb-4">
            <div class="card h-100">
              <% if (dest.image) { %>
                <img src="/images/<%= dest.image %>" class="card-img-top" alt="<%= dest.destinationName %>" />
              <% } %>
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= dest.destinationName %></h5>
                <p class="card-text flex-grow-1"><%= dest.description %></p>
                <p class="card-text"><strong>Price:</strong> $<%= dest.price.toFixed(2) %></p>

                <form action="/wishlist/<%= dest.destinationId %>" method="POST" class="mt-auto">
                  <input type="hidden" name="destination" value="1" />
                  <button type="submit" class="btn btn-primary w-100">Add to Wishlist</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>No destinations found for this list.</p>
    <% } %>

    <form method="POST" action="/wishlist/add/<%= destination.destinationId %>">
      <button type="submit" class="btn btn-primary">Add to Wishlist</button>
    </form>


    <a href="/wishlist" class="btn btn-secondary mt-3">Back to Wishlist</a>
  </div>
  
</body>
</html>
