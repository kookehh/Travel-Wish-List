<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Destinations – Travel Wishlist App</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #fde2e4; /* pastel pink */
      min-height: 100vh;
      padding-top: 80px;
    }

    .navbar {
      background-color: #212529 !important;
    }

    .navbar-brand {
      font-weight: 700;
      font-size: 1.4rem;
      color: #fff !important;
    }

    .nav-link,
    .btn-success {
      color: #fff !important;
    }

    h2 {
      font-weight: 600;
      text-align: center;
      color: #333;
    }

    .card {
      border: none;
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.95);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
    }

    .card-img-top {
      height: 200px;
      object-fit: cover;
      border-top-left-radius: 1rem;
      border-top-right-radius: 1rem;
    }

    .card-title {
      font-weight: 600;
      color: #cc5171;
    }

    .card-text {
      color: #555;
    }

    .btn-primary {
      background-color: #ff7b9c;
      border: none;
    }

    .btn-primary:hover {
      background-color: #e55c7d;
    }

    .btn-info {
      background-color: #fca3b7;
      border: none;
      color: white;
    }

    .btn-info:hover {
      background-color: #f8839e;
    }

    .btn-back {
      background-color: #c77d8e;
      color: #fff;
      border: none;
      transition: background-color 0.3s ease;
    }

    .btn-back:hover {
      background-color: #a85f73;
    }
  </style>
</head>

<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-sm navbar-dark bg-dark fixed-top">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Travel Wishlist</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">
          <% if (user && user.accounttype === 'admin') { %>
            <li class="nav-item">
              <a href="/list/<%= list.listId %>/addDestination" class="btn btn-success me-3 mt-2">Add Destination</a>
            </li>
          <% } %>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Page Content -->
  <div class="container mt-5">
    <h2 class="mb-4">Destinations</h2>

    <% if (destinations.length > 0) { %>
      <div class="row">
        <% destinations.forEach(dest => { %>
          <div class="col-md-4 mb-4">
            <div class="card h-100">
              <% if (dest.image) { %>
                <img src="/images/<%= dest.image %>" class="card-img-top" alt="<%= dest.destinationName %>" />
              <% } %>
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= dest.destinationName %></h5>
                <p class="card-text"><strong>Price:</strong> $<%= dest.price.toFixed(2) %></p>

                <form action="/wishlist/<%= dest.destinationId %>" method="POST" class="mt-auto">
                  <input type="hidden" name="destinationName" value="1" />
                  <button type="submit" class="btn btn-primary w-100">Add to Wishlist</button>
                </form>

                <a href="/destination/<%= dest.destinationId %>/event" class="btn btn-info w-100 mt-2">View Details</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="alert alert-warning text-center">No destinations found for this list.</div>
    <% } %>

    <div class="text-center">
      <a href="/wishlist" class="btn btn-back mt-4">← Back to Wishlist</a>
    </div>
  </div>

</body>
</html>
