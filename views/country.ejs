<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Countries – Travel Wishlist</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet"/>

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(to bottom right, #caf0f8, #fde2e4);
      min-height: 100vh;
      padding-top: 80px;
    }

    .navbar {
      z-index: 10;
    }

    .navbar-brand {
      font-weight: 700;
      font-size: 1.4rem;
      color: #fff !important;
    }

    .nav-link {
      color: #fff !important;
      font-weight: 500;
    }

    .hero {
      text-align: center;
      padding: 2.5rem 1rem 1.5rem;
    }

    .hero h1 {
      font-weight: 600;
      color: #222;
    }

    .hero p {
      color: #555;
      max-width: 600px;
      margin: 0 auto;
    }

    .search-bar {
      max-width: 500px;
      margin: 1.5rem auto;
    }

    .search-input {
      border-radius: 50px;
      border: 2px solid #dee2e6;
      padding-left: 2.5rem;
      background-color: #fff;
    }

    .search-input:focus {
      box-shadow: 0 0 0 0.15rem rgba(0, 119, 182, 0.25);
    }

    .search-icon {
      position: absolute;
      top: 50%;
      left: 15px;
      transform: translateY(-50%);
      color: #999;
    }

    .card {
      border: none;
      border-radius: 1rem;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    }

    .card-img-top {
      height: 200px;
      object-fit: cover;
      border-top-left-radius: 1rem;
      border-top-right-radius: 1rem;
    }

    .card-title {
      font-weight: 600;
      color: #333;
    }

    .btn-primary {
      background-color: #0077b6;
      border: none;
    }

    .btn-primary:hover {
      background-color: #023e8a;
    }

    .btn-warning {
      background-color: #ffd166;
      color: #000;
      border: none;
    }

    .btn-warning:hover {
      background-color: #ffca3a;
    }
  </style>
</head>

<body>
  <nav class="navbar navbar-expand-sm navbar-dark bg-dark fixed-top">
    <div class="container-fluid">
      <a class="navbar-brand" href="/country">Travel Wishlist</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">
          <% if (user && user.accounttype === 'user') { %>
            <li class="nav-item">
              <a class="nav-link" href="/wishlist">Profile</a>
            </li>
          <% } %>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>
          <% if (user && user.accounttype === 'admin') { %>
            <li class="nav-item">
              <a class="nav-link" href="/addCountry">Add Country</a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <section class="hero">
    <h1>Plan Your Dream Destinations</h1>
    <p>Browse countries from around the world and add them to your personal wishlist.</p>
    <form class="search-bar position-relative" action="/search" method="get" onsubmit="return true;">
      <i class="bi bi-search search-icon"></i>
      <input
        id="searchInput"
        class="form-control search-input ps-5"
        type="search"
        name="q"
        placeholder="Search destinations..."
        aria-label="Search"
        autocomplete="off"
      >
    </form>
  </section>

  <div class="container mt-4">
    <div class="row" id="countryList">
      <% country.forEach(c => { %>
        <div class="col-md-4 mb-4 country-card">
          <div class="card h-100">
            <img src="/images/<%= c.image %>" class="card-img-top" alt="<%= c.countryName %>">
            <div class="card-body text-center">
              <h5 class="card-title"><%= c.countryName %></h5>
              <a href="/country/<%= c.countryId %>/list" class="btn btn-primary mt-2 d-block">View Lists</a>
              <% if (user && user.accounttype === 'admin') { %>
                <div class="d-flex justify-content-center gap-2 mt-3">
                  <a href="/updateCountry/<%= c.countryId %>" class="btn btn-warning">Edit</a>
                  <form action="/country/deleteCountry/<%= c.countryId %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this country and all its related data?');">
                    <button type="submit" class="btn btn-danger">Delete</button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById("searchInput");
    const countryCards = document.querySelectorAll(".country-card");

    searchInput.addEventListener("input", () => {
      const keyword = searchInput.value.toLowerCase().trim();

      countryCards.forEach(card => {
        const name = card.querySelector(".card-title").textContent.toLowerCase();
        card.style.display = name.includes(keyword) ? "block" : "none";
      });
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
