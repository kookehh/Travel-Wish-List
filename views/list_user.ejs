<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Countries</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/country">Travel Wishlist</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav">
            <% if (user && user.accounttype === 'user') { %>
            <li class="nav-item">
              <a class="nav-link" href="/wishlist">Wishlist</a>
            </li>
            <% } %>
            <% if (user && user.accounttype === 'admin') { %>
              <a href="/country/<%= country.countryId %>/addList" class="btn btn-success mt-2">Add List</a>
            <% } %>

            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li> 
          </ul>
        </div>
      </div>
  </nav>
  <div class="container mt-4">
  <h2 class="text-center">All Travel Lists by Country</h2>
  <div class="row">
    <% list.forEach(list => { %>
      <div class="col-md-4 mb-4">
        <div class="card">
          <img src="/images/<%= list.image %>" class="card-img-top" alt="<%= list.listName %>">
          <div class="card-body">
            <h5 class="card-title"><%= list.listName %></h5>
            <p class="card-text">Country: <%= list.countryName %></p>
            <a href="/list/<%= list.listId %>/destinations" class="btn btn-primary">View Destinations</a>
            <% if (user && user.accounttype === 'admin') { %>
              <a href="/updateList/<%= list.listId %>" class="btn btn-warning mt-2">Edit</a>
              <a href="/country/<%= list.countryId %>/list/<%= list.listId %>/delete"
                onclick="return confirm('Are you sure you want to delete this list? This cannot be undone.');"
                class="btn btn-danger">
                Delete
              </a>
              <% } %>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
</div>

</body>
</html>
