<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Destination</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Travel WishList App</a>
      <div class="collapse navbar-collapse">
        <ul class="navbar-nav"> 
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li> 
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <h2 class="text-center mb-4">Edit Destination</h2>
    <form action="/list/<%= destination.listId %>/destinations/<%= destination.destinationId %>/edit" method="POST" enctype="multipart/form-data" class="mx-auto" style="max-width: 500px;">
      
      <input type="hidden" name="currentImage" value="<%= destination.image %>">

      <div class="mb-3">
        <label class="form-label">Current Image</label><br>
        <img src="/images/<%= destination.image %>" class="img-thumbnail mb-2" style="width: 150px;">
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Change Image</label>
        <input class="form-control" type="file" id="image" name="image" accept="image/*">
      </div>

      <div class="mb-3">
        <label for="destinationName" class="form-label">Destination Name</label>
        <input type="text" class="form-control" id="destinationName" name="destinationName" value="<%= destination.destinationName %>" required>
      </div>

      <div class="mb-3">
        <label for="price" class="form-label">Price ($)</label>
        <input type="number" class="form-control" id="price" name="price" value="<%= destination.price %>" step="0.01" required>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea class="form-control" id="description" name="description" rows="3" required><%= destination.description %></textarea>
      </div>

      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Update Destination</button>
      </div>
    </form>
  </div>
</body>
</html>

