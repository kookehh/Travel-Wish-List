<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Travel WishList App</title>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Travel WishList App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/addCountry">Add Country</a>
          </li> 
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li> 
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="container mt-4">
    <h2 class="text-center mb-4">Add New List</h2>
    <form action="/updateList/<%= list.listId %>" method="POST" enctype="multipart/form-data" class="mx-auto" style="max-width: 500px;">
  
  <!-- Hidden inputs -->
      <input type="hidden" name="currentImage" value="<%= list.image %>">
      <input type="hidden" name="countryId" value="<%= list.countryId %>">

      <div class="mb-3">
        <img src="/images/<%= list.image %>" class="img-thumbnail mt-2" style="width: 150px;">
      </div>

      <div class="mb-4">
        <label for="image" class="form-label">List Image</label>
        <input class="form-control" type="file" id="image" name="image" accept="image/*">
      </div>

      <div class="mb-3">
        <label for="name" class="form-label">List name</label>
        <input type="text" class="form-control" id="name" name="name" value="<%= list.listName %>" required>
      </div>

      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Update List</button>
      </div>
    </form>

  </div>
</body>
</html>
