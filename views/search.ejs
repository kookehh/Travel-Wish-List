<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Countries</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Travel Wishlist</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/wishlist">Wishlist</a>
            </li>  
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li>
            <% if (user && user.accounttype === 'admin') { %>
              <li class="nav-item">
                <a class="nav-link" href="/addCountry">Add Country</a>
              </li>
            <% } %>
          </ul>
        </div>
      </div>
  </nav>

  <div class="container mt-4">
    <h2>Search Results</h2>

    <% if (results.length > 0) { %>
      <div class="row">
        <% results.forEach(result => { %>
          <div class="col-md-4">
            <div class="card mb-3">
              <img src="/images/<%= result.image %>" class="card-img-top" alt="<%= result.destinationName %>">
              <div class="card-body">
                <h5 class="card-title"><%= result.destinationName %></h5>
                <a href="/country/<%= result.countryId %>/list" class="btn btn-primary">View Lists</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>No results found for "<%= searchTerm %>".</p>
    <% } %>
  </div>

