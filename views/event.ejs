<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Event Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Country-List</a>
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" href="/wishlist">Wishlist</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/logout">Logout</a>
        </li>
      </ul>
    </div>
  </nav>

  <div class="container mt-5">
    <h1><%= event.destinationName %></h1>
    <img src="/images/<%= event.image %>" width="300" class="img-thumbnail mb-3">
    <p><strong>Price:</strong> $<%= event.price.toFixed(2) %></p>
    <p><strong>Description:</strong> <%= event.description %></p>
    <a href="/destination" class="btn btn-secondary">Back</a>
  </div>
</body>
</html>
