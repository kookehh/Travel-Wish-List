  <!DOCTYPE html>
  <html lang="en">
  <head>
    <title>Add Country - Travel Wish List</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
      body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
          url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e') no-repeat center center fixed;
        background-size: cover;
        min-height: 100vh;
        padding-top: 80px;
        overflow-x: hidden;
      }

      .navbar {
        z-index: 10;
      }

      .navbar-brand {
        font-weight: 700;
        font-size: 1.4rem;
        color: #fff !important;
      }

      .form-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(8px);
        border-radius: 1rem;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
        padding: 2rem;
        max-width: 480px;
        width: 100%;
        margin: 0 auto;
        animation: fadeIn 1s ease;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .form-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
      }

      .form-header {
        background-color: #0077b6;
        color: #fff;
        padding: 1rem 1.5rem;
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        margin: -2rem -2rem 1.5rem -2rem;
      }

      h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0;
        text-align: center;
      }

      label {
        font-weight: 500;
      }

      .btn-primary {
        background-color: #0077b6;
        border: none;
        transition: background-color 0.3s ease, transform 0.2s ease;
      }

      .btn-primary:hover {
        background-color: #023e8a;
        transform: scale(1.03);
      }

      .preview-img {
        width: 100%;
        max-height: 200px;
        object-fit: cover;
        border-radius: 0.5rem;
        margin-top: 1rem;
        opacity: 0;
        transition: opacity 0.5s ease;
      }

      .preview-img.show {
        opacity: 1;
      }

      @keyframes fadeIn {
        0% {opacity: 0; transform: translateY(20px);}
        100% {opacity: 1; transform: translateY(0);}
      }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark fixed-top">
      <div class="container-fluid">
        <a class="navbar-brand" href="/country">Travel Wishlist</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link active" href="/addCountry">Add Country</a>
            </li> 
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li> 
          </ul>
        </div>
      </div>
    </nav>

    <div class="form-card mt-5">
      <div class="form-header">
        <h2>Add New Country</h2>
      </div>

      <form action="/addCountry" method="POST" enctype="multipart/form-data" class="mt-3">
        <div class="mb-3">
          <label for="image" class="form-label">Country Image</label>
          <input class="form-control" type="file" id="image" name="image" accept="image/*" required onchange="previewImage(event)">
          <img id="preview" class="preview-img" alt="Image Preview">
        </div>

        <div class="mb-3">
          <label for="name" class="form-label">Country Name</label>
          <input type="text" class="form-control" id="name" name="name" placeholder="e.g. Iceland" required>
        </div>

        <div class="d-grid">
          <button type="submit" class="btn btn-primary">Add Country</button>
        </div>
      </form>
    </div>

    <script>
      function previewImage(event) {
        const preview = document.getElementById('preview');
        preview.src = URL.createObjectURL(event.target.files[0]);
        preview.classList.add('show');
      }
    </script>

  </body>
  </html>
