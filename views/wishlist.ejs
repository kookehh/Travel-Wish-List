<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Wishlist</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet"/>
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(to bottom right, #f3e8ff, #e5d3f2);
      min-height: 100vh;
      padding-top: 80px;
    }

    .navbar {
      background-color: #6a4c93 !important;
    }

    .navbar-brand {
      font-weight: 600;
      color: #fff !important;
    }

    .nav-link {
      color: #e2e2e2 !important;
    }

    .container {
      background-color: #ffffffd8;
      padding: 2rem;
      border-radius: 1rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    h2 {
      color: #4b3869;
      font-weight: 600;
      text-align: center;
      margin-bottom: 2rem;
    }

    .table {
      border-radius: 0.5rem;
      overflow: hidden;
    }

    th {
      background-color: #d8b4fe;
      color: #333;
    }

    .img-thumbnail {
      border-radius: 8px;
    }

    .btn-danger {
      background-color: #f08080;
      border: none;
    }

    .btn-danger:hover {
      background-color: #dc6c6c;
    }

    .btn-back {
      background-color: #c084fc;
      color: #fff;
      border: none;
      border-radius: 50px;
      padding: 0.5rem 1.2rem;
      font-weight: 500;
      transition: background-color 0.3s ease;
    }

    .btn-back:hover {
      background-color: #a76de8;
    }
  </style>
</head>

<body>

  <nav class="navbar navbar-expand-sm navbar-dark fixed-top">
    <div class="container-fluid">
      <a class="navbar-brand" href="/country">Travel Wishlist</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link" href="/wishlist">Wishlist</a>
          </li> 
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li> 
        </ul>
      </div>
    </div>
  </nav>


  <div class="container mt-5">
    <h2>Your Wishlist</h2>

    <% if (wishlist.length === 0) { %>
      <p class="text-muted text-center">Your wishlist is empty. Go explore!</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered align-middle text-center">
          <thead>
            <tr>
              <th>Destination Name</th>
              <th>Image</th>
              <th>Price</th>
              <% if (user && user.accounttype === 'user') { %>
                <th>Delete</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% let total = 0; %>
            <% for (let i = 0; i < wishlist.length; i++) { %>
              <tr>
                <td><%= wishlist[i].destinationName %></td>
                <td><img src="/images/<%= wishlist[i].image %>" width="100" class="img-thumbnail"></td>
                <td>$<%= wishlist[i].price.toFixed(2) %></td>
                <% if (user && user.accounttype === 'user') { %>
                  <td>
                    <form action="/wishlist/delete/<%= wishlist[i].wishlistId %>" method="POST">
                      <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                  </td>
                <% } %>
              </tr>
            <% }; %>
          </tbody>
        </table>
      </div>


      <div class="text-center mt-4">
        <a href="/country/<%= wishlist.countryid %>" class="btn btn-back">← Back to Shopping</a>
      </div>
    <% } %>
  </div>
</body>
</html>
