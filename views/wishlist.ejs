<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Wishlist</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Country-List</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/wishlist">Wishlist</a>
            </li> 
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li> 
          </ul>
        </div>
      </div>
  </nav>
  <!-- Cart Content -->
  <div class="container">
    <h2 class="mt-4">Wishlist</h2>
    <% if (wishlist.length === 0) { %>
      <p>Your cart is empty.</p>
    <% } else { %>
      <table class="table table-bordered">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% let total = 0; %>
          <% for (let i = 0; i < wishlist.length; i++) { %>
            <tr>
                <td><%= wishlist[i].destinationName %></td>
                <td><img src="/images/<%= wishlist[i].image %>" width="80" class="img-thumbnail"></td>
                <td>$<%= (wishlist[i].price * wishlist[i].quantity).toFixed(2) %></td>
            </tr>
          <% }; %>
        </tbody>
      </table>

      <form action="/add-to-wishlist/<%= d.destinationId %>" method="POST" style="display:inline-block;">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="btn btn-primary">Add to Wishlist</button>
      </form>


      <div class="mt-4">
        <a href="/destination" class="btn btn-secondary">Back to Shopping</a>
      </div>
    <% } %>
  </div>
</body>
</html>
